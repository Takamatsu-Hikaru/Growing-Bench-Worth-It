{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growing-bench.local/schemas/task.schema.json",
  "title": "Growing Bench workspace task",
  "type": "object",
  "required": [
    "schema_version", "task_id", "track_id", "title", "kind", "fixture",
    "prompt", "checks", "baseline_expectation", "allowed_paths",
    "ignore_paths", "required_artifacts", "completion_criteria", "budget",
    "matched_group", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "growing-bench-task-2.0"},
    "task_id": {"type": "string", "minLength": 2},
    "track_id": {"const": "workspace-v0.2"},
    "title": {"type": "string", "minLength": 4},
    "kind": {"enum": ["code", "writing", "internal_review", "external_peer_review"]},
    "fixture": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 20},
    "authorization": {"type": "string"},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "command"],
        "properties": {
          "name": {"type": "string"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "baseline_expectation": {"enum": ["passing", "failing"]},
    "expected_failure": {
      "type": ["object", "null"],
      "properties": {
        "check": {"type": "string"},
        "returncode": {"type": "integer"},
        "contains": {"type": "string"}
      },
      "required": ["check", "returncode", "contains"],
      "additionalProperties": false
    },
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "ignore_paths": {"type": "array", "items": {"type": "string"}},
    "required_artifacts": {"type": "array", "items": {"type": "string"}},
    "completion_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "description", "kind", "weight"],
        "properties": {
          "criterion_id": {"type": "string"},
          "description": {"type": "string"},
          "kind": {"enum": ["check", "file_exists", "file_contains", "json_field", "semantic"]},
          "check": {"type": "string"},
          "path": {"type": "string"},
          "contains": {"type": "string"},
          "field": {"type": "string"},
          "equals": {},
          "weight": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object", "required": ["human_minutes", "machine_minutes", "compute_cost"],
      "properties": {
        "human_minutes": {"type": "number", "exclusiveMinimum": 0},
        "machine_minutes": {"type": "number", "exclusiveMinimum": 0},
        "compute_cost": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "matched_group": {
      "type": "object", "required": ["group_id", "variant"],
      "properties": {
        "group_id": {"type": "string"},
        "variant": {"type": "string"}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
